<Window x:Class="PrimeShift.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrimeShift.Settings"
        Title="PrimeShift 设置"
        Icon="/Assets/app.ico"
        Width="1080" Height="760" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PrimaryBadge" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Compact monitor row used inside an expanded layout card. -->
            <DataTemplate x:Key="MonitorRow" DataType="{x:Type local:MonitorItem}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Margin="0,0,12,0" Text="&#xE7F4;"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                            <Border Style="{StaticResource PrimaryBadge}"
                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="主屏" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Navigation pane ============ -->
        <DockPanel Margin="4,12,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,4,0,20">
                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="20" Height="20" />
                <TextBlock Text="PrimeShift" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNavigate"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        <TextBlock Text="常规" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <ListBox x:Name="MainNav" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNavigate"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="Layouts" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C4;" />
                        <TextBlock Text="布局" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Monitors">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" />
                        <TextBlock Text="显示器" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ============ Content layer ============ -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <!-- ===== Layouts page ===== -->
                <ScrollViewer x:Name="LayoutsPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,32,40,40" MaxWidth="1000">
                        <TextBlock Style="{StaticResource PageTitle}" Text="布局" />
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Text="保存显示布局，用全局快捷键或托盘菜单一键切换。远程时切到「仅 KVM 屏」，回来后一键恢复。" />

                        <local:InfoBar x:Name="AgentInfoBar" Severity="Warning" Visibility="Collapsed"
                                       Message="托盘程序没有运行，快捷键和托盘菜单暂时不可用。">
                            <Button Content="启动" MinWidth="72" Click="OnStartAgent" />
                        </local:InfoBar>
                        <local:InfoBar Message="设置窗口打开期间，全局快捷键暂停生效，关闭窗口后自动恢复。" />

                        <TextBlock Style="{StaticResource GroupHeader}" Text="新建" />
                        <local:SettingsCard Icon="&#xE710;" Header="保存当前布局"
                                            Description="先在 Windows 显示设置里把屏幕调成想要的样子（例如只保留 KVM 屏并设为主屏），再保存为新布局。">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="200">
                                    <TextBox x:Name="NewNameBox" TextChanged="OnNewNameChanged" KeyDown="OnNewNameKeyDown" />
                                    <TextBlock x:Name="NewNamePlaceholder" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="名称，例如 remote" />
                                </Grid>
                                <Button Margin="8,0,0,0" MinWidth="72" Content="保存" Style="{DynamicResource AccentButtonStyle}"
                                        Click="OnSaveCurrent" />
                            </StackPanel>
                        </local:SettingsCard>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="已保存的布局" />
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" Margin="1,0,0,8" Text="还没有保存任何布局。" />

                        <ItemsControl x:Name="ProfileList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProfileItem}">
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <ToggleButton Style="{StaticResource ExpanderHeader}" IsChecked="{Binding IsExpanded}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Glyph}" FontSize="20" Margin="2,0,18,0" Text="&#xE7F4;" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" />
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding Overview}" />
                                                        <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                   Text="{Binding Error}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" ToolTip="修改快捷键"
                                                            Click="OnEditShortcut">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding HotkeyParts}"
                                                                          Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="设置快捷键" Margin="2,0,6,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                       Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                            <TextBlock Style="{StaticResource Glyph}" FontSize="14" Margin="4,0,2,0" Text="&#xE70F;" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="3" Margin="12,0,0,0" MinWidth="72" Content="应用" Click="OnApply"
                                                            ToolTip="立即切换到这个布局" />
                                                </Grid>
                                            </ToggleButton>

                                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <Border Style="{StaticResource Divider}" />
                                                <Grid Style="{StaticResource ExpanderRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="名称" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Width="240" Text="{Binding Name, Mode=OneWay}"
                                                             LostKeyboardFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                                </Grid>
                                                <Border Style="{StaticResource Divider}" />
                                                <Grid Style="{StaticResource ExpanderRow}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="包含的显示器" />
                                                    <ItemsControl Grid.Row="1" Margin="0,6,0,0" Focusable="False"
                                                                  ItemsSource="{Binding Monitors}" ItemTemplate="{StaticResource MonitorRow}" />
                                                </Grid>
                                                <Border Style="{StaticResource Divider}" />
                                                <Grid Style="{StaticResource ExpanderRow}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                               Text="保存后又调整了显示设置？可以用当前布局覆盖它。" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="用当前布局覆盖" Click="OnOverwrite" />
                                                        <Button Margin="8,0,0,0" Click="OnDelete">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE74D;" />
                                                                <TextBlock Text="删除" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Monitors page ===== -->
                <ScrollViewer x:Name="MonitorsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,32,40,40" MaxWidth="1000">
                        <TextBlock Style="{StaticResource PageTitle}" Text="显示器" />
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Text="当前连接到这台电脑的显示器。保存布局前，可以在这里核对分辨率、刷新率和主屏。" />

                        <local:SettingsCard Icon="&#xE7F8;" Header="Windows 显示设置"
                                            Description="调整分辨率、排列和主屏，或断开某块显示器。">
                            <Button Click="OnOpenDisplaySettings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="打开" />
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Margin="8,0,0,0" Text="&#xE8A7;" />
                                </StackPanel>
                            </Button>
                        </local:SettingsCard>

                        <Grid Margin="0,28,0,8">
                            <TextBlock Style="{StaticResource GroupHeader}" Margin="1,0,0,0" VerticalAlignment="Center" Text="已连接" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButton}" Click="OnRefreshMonitors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE72C;" />
                                    <TextBlock Text="刷新" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="MonitorList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:MonitorItem}">
                                    <local:SettingsCard Icon="&#xE7F4;" Header="{Binding Name}" Description="{Binding Detail}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource PrimaryBadge}"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="主屏" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Caption}" Text="未启用"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        </StackPanel>
                                    </local:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <local:InfoBar x:Name="MonitorError" Severity="Error" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== General page ===== -->
                <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,32,40,40" MaxWidth="1000">
                        <TextBlock Style="{StaticResource PageTitle}" Text="常规" />

                        <Border Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,12,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="48" Height="48" />
                                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="PrimeShift" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="一键将 KVM 屏切为主屏，远程操作时开始菜单、任务栏和窗口都在 KVM 画面里。" />
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Click="OnOpenRepository">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GitHub" />
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Margin="8,0,0,0" Text="&#xE8A7;" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="启动" />
                        <local:SettingsCard Icon="&#xE7E8;" Header="开机自启" Description="登录 Windows 后在后台运行 PrimeShift，快捷键随时可用。">
                            <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource ToggleSwitch}"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" />
                        </local:SettingsCard>
                        <local:InfoBar x:Name="AutoStartStale" Severity="Warning" Visibility="Collapsed"
                                       Message="自启项指向的是另一个位置的 PrimeShift.exe（可能已经移动过）。关闭再打开开关即可改为当前位置。" />

                        <TextBlock Style="{StaticResource GroupHeader}" Text="通知" />
                        <local:SettingsCard Icon="&#xEA8F;" Header="切换布局后显示通知"
                                            Description="通过快捷键或托盘菜单切换后，弹出通知提示结果。切换失败时总会提示。">
                            <CheckBox x:Name="NotifySwitch" Style="{StaticResource ToggleSwitch}"
                                      Checked="OnNotifyChanged" Unchecked="OnNotifyChanged" />
                        </local:SettingsCard>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="数据" />
                        <local:SettingsCard x:Name="DataCard" Icon="&#xE838;" Header="配置与日志">
                            <Button Content="打开文件夹" Click="OnOpenDataFolder" />
                        </local:SettingsCard>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ Shortcut dialog (PowerToys-style "activation shortcut") ============ -->
        <Grid x:Name="ShortcutOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Focusable="True"
              Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.28" />
                </Border.Effect>
                <StackPanel>
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="8,8,0,0" Padding="24,24,24,20">
                        <StackPanel>
                            <TextBlock Text="激活快捷键" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="ShortcutDialogTarget" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Margin="0,16,0,0" Text="按下组合键来更改此快捷键" />
                            <Border Margin="0,12,0,0" Height="100" CornerRadius="4"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <ItemsControl x:Name="PendingKeys" Style="{StaticResource LargeKeyCaps}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PendingPlaceholder" Style="{StaticResource Caption}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="等待按键…" />
                                </Grid>
                            </Border>
                            <local:InfoBar x:Name="ShortcutStatus" Margin="0,12,0,0" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       Text="需包含 Win、Ctrl、Alt 或 Shift；只用 Shift 时仅限 F1–F24。按 Enter 保存，Esc 取消；清除后直接保存可取消快捷键。" />
                        </StackPanel>
                    </Border>
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="24">
                        <UniformGrid Columns="3">
                            <Button x:Name="SaveShortcutButton" Content="保存" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                    Style="{DynamicResource AccentButtonStyle}" Click="OnSaveShortcut" />
                            <Button Content="清除" Margin="4,0" HorizontalAlignment="Stretch" Click="OnClearShortcut" />
                            <Button Content="取消" Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="OnCancelShortcut" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
